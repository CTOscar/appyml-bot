# Servicio de agentes. Copia a .env y llena (este archivo NO se sube a git).
PORT=3100
NODE_ENV=development

# --- Claude ---
# Clave de Anthropic: vive SOLO aquí, nunca en el navegador ni en panel-flota-api.
ANTHROPIC_API_KEY=
# Los IDs de modelo se configuran aquí, no en el código.
MODEL_CAMPO=claude-haiku-5-5
MODEL_TALLER=claude-sonnet-5-5
MODEL_ESTRATEGIA=claude-opus-5-5

# --- MySQL (la MISMA base que panel-flota-api) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
# Recomendado: un usuario MySQL de SOLO LECTURA para el servidor MCP Fleet-DB.
# Si no se define, usa DB_USER/DB_PASSWORD.
MCP_DB_USER=
MCP_DB_PASSWORD=

# --- Sesión del panel ---
# El servicio valida la cookie contra la API del panel y no confía en el rol que mande el navegador.
PANEL_API_URL=http://localhost:3000/api/panel
SESSION_COOKIE=pf_sid
# Orígenes del panel que pueden llamar a /chat (con cookies).
ALLOWED_ORIGINS=http://localhost:3000

# --- Traccar real (solo para `npm run sync:equipos:traccar`) ---
# Dirección del servidor, con http:// o https:// (ej. https://traccar.tudominio.mx o http://IP:8082) y una cuenta de lectura.
TRACCAR_URL=
TRACCAR_EMAIL=
TRACCAR_PASSWORD=
