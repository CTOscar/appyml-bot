# Copia como .env (no se versiona). Todas son opcionales.
# Datos simulados (true) o Traccar real (false)
VITE_USE_MOCK=true
# Cuántos tractores inventa el simulado (por defecto 5, los del piloto)
VITE_MOCK_FLEET=5
# Dirección de Traccar cuando VITE_USE_MOCK=false (vacío = misma dirección del panel)
VITE_TRACCAR_URL=
# API del panel: same-origin = /api/panel en la misma dirección (en desarrollo, por el proxy de Vite)
VITE_PANEL_API_URL=same-origin
VITE_DIESEL_PRICE=24
# Solo desarrollo: a dónde reenvía el proxy /api/panel y con qué Origin (debe estar en ALLOWED_ORIGINS de la API)
PANEL_PROXY=http://localhost:3000
PANEL_ORIGIN=
# Servicio de agentes (chat del Taller)
VITE_AGENTS_URL=http://localhost:3100
